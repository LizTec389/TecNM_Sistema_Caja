# ==========================================
# Base de Datos (PostgreSQL 17 - tecnm_caja)
# ==========================================
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=tecnm_caja;Username=postgres;Password=postgrespassword123"

# ==========================================
# Autenticación JWT (Mínimo 32 bytes UTF-8)
# ==========================================
Jwt__SecretKey="TecNM_Monclova_SuperSecretKey_2026_Min32Bytes!"
Jwt__Issuer="TecNM.Api"
Jwt__Audience="TecNM.Frontend"
Jwt__LifetimeHours=8

# ==========================================
# CORS (Frontend)
# ==========================================
Cors__AllowedOrigin="http://localhost:5173"
